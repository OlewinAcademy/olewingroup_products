<svg xmlns="http://w3.org" viewBox="0 0 800 400" width="100%" height="100%">
  <defs>
    <!-- Modern Gradient for the Typography -->
    <linearGradient id="bmhGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00F2FE" />
      <stop offset="100%" stop-color="#4FACFE" />
    </linearGradient>
    
    <!-- Subtle drop shadow to give depth to the geometric pieces -->
    <filter id="dropShadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="#000000" flood-opacity="0.5"/>
    </filter>
  </defs>

  <!-- Background Layer -->
  <rect width="100%" height="100%" fill="#0A0E1A" rx="16" />

  <!-- Center Composition Wrapper -->
  <g transform="translate(100, 100)" filter="url(#dropShadow)">
    
    <!-- LETTER B -->
    <g transform="translate(0, 0)">
      <!-- Main Vertical Backbone -->
      <path d="M 0,0 L 45,0 L 45,200 L 0,200 Z" fill="url(#bmhGradient)" />
      <!-- Top Loop (Geometric) -->
      <path d="M 45,0 L 110,0 C 145,0 145,90 110,90 L 45,90 Z" fill="url(#bmhGradient)" opacity="0.9" />
      <!-- Bottom Loop (Geometric) -->
      <path d="M 45,95 L 115,95 C 155,95 155,200 115,200 L 45,200 Z" fill="url(#bmhGradient)" />
      <!-- Inner Cutouts for B -->
      <path d="M 45,25 L 95,25 C 110,25 110,65 95,65 L 45,65 Z" fill="#0A0E1A" />
      <path d="M 45,120 L 100,120 C 115,120 115,175 100,175 L 45,175 Z" fill="#0A0E1A" />
    </g>

    <!-- LETTER M -->
    <g transform="translate(200, 0)">
      <!-- Left Pillar -->
      <path d="M 0,0 L 40,0 L 40,200 L 0,200 Z" fill="url(#bmhGradient)" />
      <!-- Left Diagonal Descent -->
      <path d="M 40,0 L 100,130 L 100,185 L 40,55 Z" fill="url(#bmhGradient)" opacity="0.9" />
      <!-- Right Diagonal Descent -->
      <path d="M 160,0 L 100,130 L 100,185 L 160,55 Z" fill="url(#bmhGradient)" opacity="0.9" />
      <!-- Right Pillar -->
      <path d="M 160,0 L 200,0 L 200,200 L 160,200 Z" fill="url(#bmhGradient)" />
    </g>

    <!-- LETTER H -->
    <g transform="translate(440, 0)">
      <!-- Left Pillar -->
      <path d="M 0,0 L 45,0 L 45,200 L 0,200 Z" fill="url(#bmhGradient)" />
      <!-- Middle Crossbar -->
      <path d="M 45,80 L 115,80 L 115,120 L 45,120 Z" fill="url(#bmhGradient)" opacity="0.9" />
      <!-- Right Pillar -->
      <path d="M 115,0 L 160,0 L 160,200 L 115,200 Z" fill="url(#bmhGradient)" />
    </g>

  </g>
</svg>
